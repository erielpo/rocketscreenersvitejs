FROM node:22-alpine AS build

WORKDIR /app
RUN corepack enable

ARG VITE_ADSENSE_SLOT_DEFAULT
ARG VITE_ADSENSE_SLOT_DASHBOARD_TOP
ARG VITE_ADSENSE_SLOT_DASHBOARD_IN_FEED
ARG VITE_ADSENSE_SLOT_GAINERS_TOP
ARG VITE_ADSENSE_SLOT_GAINERS_BOTTOM
ARG VITE_ADSENSE_SLOT_LOSERS_TOP
ARG VITE_ADSENSE_SLOT_LOSERS_BOTTOM
ARG VITE_ADSENSE_SLOT_PRE_ALERTS_TOP
ARG VITE_ADSENSE_SLOT_PRE_ALERTS_BOTTOM
ARG VITE_ADSENSE_SLOT_ALERTS_RUNNER_TOP
ARG VITE_ADSENSE_SLOT_ALERTS_RUNNER_BOTTOM
ARG VITE_ADSENSE_SLOT_HALTS_TOP
ARG VITE_ADSENSE_SLOT_HALTS_BOTTOM
ARG VITE_ADSENSE_SLOT_BID_ASK_TOP
ARG VITE_ADSENSE_SLOT_BID_ASK_BOTTOM
ARG VITE_ADSENSE_SLOT_CONFIGURATION_TOP
ARG VITE_ADSENSE_SLOT_CONFIGURATION_BOTTOM
ARG VITE_ADSENSE_SLOT_STOCK_TOP
ARG VITE_ADSENSE_SLOT_STOCK_BOTTOM

ENV VITE_ADSENSE_SLOT_DEFAULT=$VITE_ADSENSE_SLOT_DEFAULT
ENV VITE_ADSENSE_SLOT_DASHBOARD_TOP=$VITE_ADSENSE_SLOT_DASHBOARD_TOP
ENV VITE_ADSENSE_SLOT_DASHBOARD_IN_FEED=$VITE_ADSENSE_SLOT_DASHBOARD_IN_FEED
ENV VITE_ADSENSE_SLOT_GAINERS_TOP=$VITE_ADSENSE_SLOT_GAINERS_TOP
ENV VITE_ADSENSE_SLOT_GAINERS_BOTTOM=$VITE_ADSENSE_SLOT_GAINERS_BOTTOM
ENV VITE_ADSENSE_SLOT_LOSERS_TOP=$VITE_ADSENSE_SLOT_LOSERS_TOP
ENV VITE_ADSENSE_SLOT_LOSERS_BOTTOM=$VITE_ADSENSE_SLOT_LOSERS_BOTTOM
ENV VITE_ADSENSE_SLOT_PRE_ALERTS_TOP=$VITE_ADSENSE_SLOT_PRE_ALERTS_TOP
ENV VITE_ADSENSE_SLOT_PRE_ALERTS_BOTTOM=$VITE_ADSENSE_SLOT_PRE_ALERTS_BOTTOM
ENV VITE_ADSENSE_SLOT_ALERTS_RUNNER_TOP=$VITE_ADSENSE_SLOT_ALERTS_RUNNER_TOP
ENV VITE_ADSENSE_SLOT_ALERTS_RUNNER_BOTTOM=$VITE_ADSENSE_SLOT_ALERTS_RUNNER_BOTTOM
ENV VITE_ADSENSE_SLOT_HALTS_TOP=$VITE_ADSENSE_SLOT_HALTS_TOP
ENV VITE_ADSENSE_SLOT_HALTS_BOTTOM=$VITE_ADSENSE_SLOT_HALTS_BOTTOM
ENV VITE_ADSENSE_SLOT_BID_ASK_TOP=$VITE_ADSENSE_SLOT_BID_ASK_TOP
ENV VITE_ADSENSE_SLOT_BID_ASK_BOTTOM=$VITE_ADSENSE_SLOT_BID_ASK_BOTTOM
ENV VITE_ADSENSE_SLOT_CONFIGURATION_TOP=$VITE_ADSENSE_SLOT_CONFIGURATION_TOP
ENV VITE_ADSENSE_SLOT_CONFIGURATION_BOTTOM=$VITE_ADSENSE_SLOT_CONFIGURATION_BOTTOM
ENV VITE_ADSENSE_SLOT_STOCK_TOP=$VITE_ADSENSE_SLOT_STOCK_TOP
ENV VITE_ADSENSE_SLOT_STOCK_BOTTOM=$VITE_ADSENSE_SLOT_STOCK_BOTTOM

COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

COPY . .
RUN pnpm build

FROM nginx:1.27-alpine

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
